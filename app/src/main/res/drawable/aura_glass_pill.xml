<?xml version="1.0" encoding="utf-8"?>
<!-- AURA: a frosted pill for small buttons over content. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#1FFFFFFF" />
            <stroke android:width="1dp" android:color="#24FFFFFF" />
        </shape>
    </item>
</ripple>
