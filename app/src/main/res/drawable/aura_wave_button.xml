<?xml version="1.0" encoding="utf-8"?>
<!-- AURA: "My Wave" button, frosted glass over the glow: mostly see-through, a thin bright rim. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33FFFFFF">
    <item>
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <gradient
                        android:angle="300"
                        android:startColor="#33FFFFFF"
                        android:endColor="#0DFFFFFF"
                        android:type="linear" />
                </shape>
            </item>
            <item>
                <shape android:shape="oval">
                    <stroke android:width="1.2dp" android:color="#59FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
