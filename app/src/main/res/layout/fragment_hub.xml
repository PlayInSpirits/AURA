<?xml version="1.0" encoding="utf-8"?>
<!-- AURA: the Hub opens as its own window. The app's tab bar and mini player step aside; the hub's
     own tab bar is the bottom bar here, and «Назад» at the top leads back to the app. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/hub_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/hub_top_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="16dp">

        <LinearLayout
            android:id="@+id/hub_back_button"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/aura_glass_pill"
            android:clickable="true"
            android:contentDescription="@string/aura_hub_back"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_arrow_back"
                app:tint="?attr/colorOnSurface" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/aura_hub_back"
                android:textColor="?attr/colorOnSurface"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/aura_hub_title"
            android:textColor="?attr/colorOnSurface"
            android:textSize="20sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/hub_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="true"
        android:indeterminateTint="?attr/colorPrimary"
        android:visibility="gone" />

    <!-- The hub WebView lives on between visits (see HubWebHost), so whatever the hub page plays
         keeps playing elsewhere in the app. It is attached here. -->
    <FrameLayout
        android:id="@+id/hub_web_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/hub_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/aura_hub_not_connected" />

        <Button
            android:id="@+id/hub_connect_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/aura_hub_connect" />
    </LinearLayout>
</LinearLayout>
