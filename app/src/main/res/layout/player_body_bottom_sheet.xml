<?xml version="1.0" encoding="utf-8"?>
<!-- AURA: the player sits on a backdrop painted from the cover: the cover itself, blurred, under a
     gradient of its main colour (see AuraPlayerBackdrop). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/player_body_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/aura_player_background">

    <ImageView
        android:id="@+id/aura_player_backdrop_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.55"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <View
        android:id="@+id/aura_player_backdrop_tint"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <FrameLayout
        android:id="@+id/player_controller_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/player_queue_compose_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
</FrameLayout>
