<?xml version="1.0" encoding="utf-8"?>
<!-- AURA: the full-screen player. Big cover, the song left-aligned with ♥ and ⋯, a thick bar, white
     controls around a large white play button, the extras in a frosted strip. It sits on a backdrop
     painted from the cover (see AuraPlayerBackdrop), so everything here is light on dark. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/now_playing_media_controller_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/player_media_quality_sector"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="52dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:id="@+id/aura_player_grabber"
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/aura_grabber"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <Button
            android:id="@+id/player_playback_speed_button"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="12dp"
            android:minWidth="64dp"
            android:textColor="#E6FFFFFF"
            android:textSize="13sp"
            app:cornerRadius="20dp"
            app:layout_constraintBottom_toBottomOf="@id/player_media_quality_sector_center"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/player_media_quality_sector_center" />

        <ImageButton
            android:id="@+id/player_info_track"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="11dp"
            android:scaleType="fitCenter"
            app:layout_constraintBottom_toBottomOf="@id/player_media_quality_sector_center"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/player_media_quality_sector_center"
            app:srcCompat="@drawable/ic_info_stream"
            app:tint="#B3FFFFFF" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/player_media_quality_sector_center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/aura_glass_pill"
            android:paddingStart="4dp"
            android:paddingEnd="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.chip.Chip
                android:id="@+id/player_media_extension"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="32dp"
                android:text="Unknown"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp"
                app:chipBackgroundColor="#33FFFFFF"
                app:chipMinHeight="26dp"
                app:chipStrokeWidth="0dp"
                app:ensureMinTouchTargetSize="false"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/player_media_bitrate"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/player_media_bitrate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp"
                app:layout_constraintBottom_toBottomOf="@id/player_media_extension"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/player_media_extension"
                app:layout_constraintTop_toTopOf="@id/player_media_extension" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <include
        android:id="@+id/player_asset_link_row"
        layout="@layout/view_asset_link_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/player_media_quality_sector" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/player_media_cover_view_pager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toTopOf="@id/guideline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/player_asset_link_row" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.56" />

    <LinearLayout
        android:id="@+id/rating_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:scaleX="0.8"
        android:scaleY="0.8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/guideline">

        <RatingBar
            android:id="@+id/song_rating_bar"
            style="?android:attr/ratingBarStyleIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:isIndicator="false"
            android:numStars="5"
            android:progressTint="#FFFFFFFF"
            android:rating="0"
            android:stepSize="1" />

        <TextView
            android:id="@+id/rating_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text=""
            android:textColor="#B3FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/player_media_title_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="12dp"
        android:ellipsize="marquee"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:singleLine="true"
        android:text="@string/label_placeholder"
        android:textColor="#FFFFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/button_favorite"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rating_container" />

    <TextView
        android:id="@+id/player_artist_name_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="12dp"
        android:ellipsize="marquee"
        android:singleLine="true"
        android:text="@string/label_placeholder"
        android:textColor="#B3FFFFFF"
        android:textSize="17sp"
        app:layout_constraintEnd_toStartOf="@+id/button_favorite"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/player_media_title_label" />

    <androidx.appcompat.widget.AppCompatToggleButton
        android:id="@+id/button_favorite"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginEnd="18dp"
        android:background="@drawable/button_favorite_selector"
        android:backgroundTint="@color/aura_favorite_tint"
        android:checked="false"
        android:text=""
        android:textOff=""
        android:textOn=""
        app:layout_constraintBottom_toBottomOf="@+id/player_artist_name_label"
        app:layout_constraintEnd_toStartOf="@id/player_overflow_button"
        app:layout_constraintTop_toTopOf="@+id/player_media_title_label" />

    <ImageButton
        android:id="@+id/player_overflow_button"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="18dp"
        android:background="@drawable/aura_glass_circle"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_more_vert"
        app:layout_constraintBottom_toBottomOf="@+id/player_artist_name_label"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/player_media_title_label"
        app:tint="#FFFFFFFF" />

    <androidx.media3.ui.DefaultTimeBar
        android:id="@id/exo_progress"
        android:layout_width="0dp"
        android:layout_height="26dp"
        android:layout_marginStart="18dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="18dp"
        app:bar_height="5dp"
        app:buffered_color="#4DFFFFFF"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/player_artist_name_label"
        app:played_color="#FFFFFFFF"
        app:scrubber_color="#FFFFFFFF"
        app:scrubber_dragged_size="22dp"
        app:scrubber_enabled_size="13dp"
        app:unplayed_color="#26FFFFFF" />

    <TextView
        android:id="@+id/exo_position"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:fontFeatureSettings="tnum"
        android:text="@string/label_placeholder"
        android:textColor="#99FFFFFF"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/exo_progress" />

    <TextView
        android:id="@+id/exo_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="28dp"
        android:fontFeatureSettings="tnum"
        android:text="@string/label_placeholder"
        android:textColor="#99FFFFFF"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/exo_progress" />

    <!-- Controls: shuffle · previous · PLAY · next · repeat -->
    <View
        android:id="@+id/player_play_pause_placeholder_view"
        android:layout_width="80dp"
        android:layout_height="80dp"
        app:layout_constraintBottom_toTopOf="@+id/player_quick_action_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/exo_position"
        app:layout_constraintVertical_bias=".4" />

    <View
        android:id="@+id/placeholder_view_left"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="30dp"
        app:layout_constraintBottom_toBottomOf="@+id/player_play_pause_placeholder_view"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/player_play_pause_placeholder_view" />

    <View
        android:id="@+id/placeholder_view_right"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginEnd="30dp"
        app:layout_constraintBottom_toBottomOf="@+id/player_play_pause_placeholder_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/player_play_pause_placeholder_view" />

    <View
        android:id="@+id/placeholder_view_middle_left"
        android:layout_width="52dp"
        android:layout_height="52dp"
        app:layout_constraintBottom_toBottomOf="@+id/player_play_pause_placeholder_view"
        app:layout_constraintEnd_toStartOf="@+id/player_play_pause_placeholder_view"
        app:layout_constraintStart_toEndOf="@id/placeholder_view_left"
        app:layout_constraintTop_toTopOf="@+id/player_play_pause_placeholder_view" />

    <View
        android:id="@+id/placeholder_view_middle_right"
        android:layout_width="52dp"
        android:layout_height="52dp"
        app:layout_constraintBottom_toBottomOf="@+id/player_play_pause_placeholder_view"
        app:layout_constraintEnd_toStartOf="@id/placeholder_view_right"
        app:layout_constraintStart_toEndOf="@+id/player_play_pause_placeholder_view"
        app:layout_constraintTop_toTopOf="@+id/player_play_pause_placeholder_view" />

    <ImageButton
        android:id="@+id/exo_shuffle"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="8dp"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="@+id/placeholder_view_left"
        app:layout_constraintEnd_toEndOf="@+id/placeholder_view_left"
        app:layout_constraintStart_toStartOf="@+id/placeholder_view_left"
        app:layout_constraintTop_toTopOf="@+id/placeholder_view_left"
        app:srcCompat="@drawable/ic_shuffle"
        app:tint="#E6FFFFFF" />

    <ImageButton
        android:id="@+id/exo_rew"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_replay"
        app:layout_constraintBottom_toBottomOf="@+id/placeholder_view_middle_left"
        app:layout_constraintEnd_toEndOf="@+id/placeholder_view_middle_left"
        app:layout_constraintStart_toStartOf="@+id/placeholder_view_middle_left"
        app:layout_constraintTop_toTopOf="@+id/placeholder_view_middle_left"
        app:tint="#FFFFFFFF" />

    <ImageButton
        android:id="@+id/exo_prev"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="8dp"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="@+id/placeholder_view_middle_left"
        app:layout_constraintEnd_toEndOf="@+id/placeholder_view_middle_left"
        app:layout_constraintStart_toStartOf="@+id/placeholder_view_middle_left"
        app:layout_constraintTop_toTopOf="@+id/placeholder_view_middle_left"
        app:srcCompat="@drawable/ic_skip_previous"
        app:tint="#FFFFFFFF" />

    <ImageButton
        android:id="@id/exo_play_pause"
        style="@style/ExoStyledControls.Button.Center.PlayPause"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:background="@drawable/aura_play_circle"
        android:elevation="10dp"
        android:padding="22dp"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="@+id/player_play_pause_placeholder_view"
        app:layout_constraintEnd_toEndOf="@+id/player_play_pause_placeholder_view"
        app:layout_constraintStart_toStartOf="@+id/player_play_pause_placeholder_view"
        app:layout_constraintTop_toTopOf="@+id/player_play_pause_placeholder_view"
        app:tint="#FF0E0C16" />

    <ImageButton
        android:id="@+id/exo_next"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="8dp"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="@+id/placeholder_view_middle_right"
        app:layout_constraintEnd_toEndOf="@+id/placeholder_view_middle_right"
        app:layout_constraintStart_toStartOf="@+id/placeholder_view_middle_right"
        app:layout_constraintTop_toTopOf="@+id/placeholder_view_middle_right"
        app:srcCompat="@drawable/ic_skip_next"
        app:tint="#FFFFFFFF" />

    <ImageButton
        android:id="@+id/exo_ffwd"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="@+id/placeholder_view_middle_right"
        app:layout_constraintEnd_toEndOf="@+id/placeholder_view_middle_right"
        app:layout_constraintStart_toStartOf="@+id/placeholder_view_middle_right"
        app:layout_constraintTop_toTopOf="@+id/placeholder_view_middle_right"
        app:srcCompat="@drawable/ic_forward"
        app:tint="#FFFFFFFF" />

    <ImageButton
        android:id="@+id/exo_repeat_toggle"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="8dp"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="@+id/placeholder_view_right"
        app:layout_constraintEnd_toEndOf="@+id/placeholder_view_right"
        app:layout_constraintStart_toStartOf="@+id/placeholder_view_right"
        app:layout_constraintTop_toTopOf="@+id/placeholder_view_right"
        app:srcCompat="@drawable/ic_repeat"
        app:tint="#E6FFFFFF" />

    <ToggleButton
        android:id="@+id/player_skip_silence_toggle_button"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:background="@drawable/button_skip_silence_selector"
        android:backgroundTint="#FFFFFFFF"
        android:text=""
        android:textOff=""
        android:textOn=""
        app:layout_constraintBottom_toBottomOf="@+id/placeholder_view_right"
        app:layout_constraintEnd_toEndOf="@+id/placeholder_view_right"
        app:layout_constraintStart_toStartOf="@+id/placeholder_view_right"
        app:layout_constraintTop_toTopOf="@+id/placeholder_view_right" />

    <!-- Extras in a frosted strip -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/player_quick_action_view"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/aura_glass_bar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/player_sleep_timer_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/player_open_lyrics_button"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/player_sleep_timer_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                app:srcCompat="@drawable/ic_timer"
                app:tint="#E6FFFFFF" />

            <TextView
                android:id="@+id/player_sleep_timer_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#CCFFFFFF"
                android:textSize="9sp"
                android:visibility="gone" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/player_open_lyrics_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/player_add_to_playlist_button"
            app:layout_constraintStart_toEndOf="@+id/player_sleep_timer_container"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_lyrics"
            app:tint="#E6FFFFFF" />

        <ImageButton
            android:id="@+id/player_add_to_playlist_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/aura_player_add_to_playlist"
            android:padding="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/player_open_queue_button"
            app:layout_constraintStart_toEndOf="@+id/player_open_lyrics_button"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_playlist_add"
            app:tint="#E6FFFFFF" />

        <ImageButton
            android:id="@+id/player_open_queue_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/player_add_to_playlist_button"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_queue"
            app:tint="#E6FFFFFF" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
