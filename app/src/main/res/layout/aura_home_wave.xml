<?xml version="1.0" encoding="utf-8"?>
<!-- AURA: "My Wave" hero, the whole first screen of Home. Its glow reaches under the status bar and the
     transparent top bar; its height is set by the code to end where the bottom bars begin. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/aura_wave_block"
    android:layout_width="match_parent"
    android:layout_height="560dp"
    android:clipChildren="false">

    <!-- Living glow of the wave (AGSL on Android 13+, a still glow before) -->
    <com.eddyizm.tempus.ui.view.WaveGlowView
        android:id="@+id/aura_wave_glow"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- The hero melts into the sections below -->
    <View
        android:id="@+id/aura_wave_fade"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:layout_gravity="bottom"
        android:background="@drawable/aura_hero_fade" />

    <LinearLayout
        android:id="@+id/aura_wave_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="72dp"
        android:clipChildren="false"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/aura_wave_button"
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:background="@drawable/aura_wave_button"
            android:clickable="true"
            android:contentDescription="@string/aura_wave_play"
            android:focusable="true">

            <ImageView
                android:id="@+id/aura_wave_icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_play"
                app:tint="@android:color/white" />

            <ProgressBar
                android:id="@+id/aura_wave_progress"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:indeterminate="true"
                android:indeterminateTint="#E6FFFFFF"
                android:padding="8dp"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/aura_wave_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:letterSpacing="0.02"
            android:maxLines="1"
            android:shadowColor="#66000000"
            android:shadowDy="2"
            android:shadowRadius="12"
            android:text="@string/aura_wave_title"
            android:textColor="#FFFFFFFF"
            android:textSize="34sp" />

        <TextView
            android:id="@+id/aura_wave_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="40dp"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:shadowColor="#55000000"
            android:shadowRadius="8"
            android:text="@string/aura_wave_hint"
            android:textColor="#BFFFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- "There is more below" -->
    <LinearLayout
        android:id="@+id/aura_wave_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="18dp"
        android:alpha="0.75"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/aura_wave_hint_arrow"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:importantForAccessibility="no"
            android:rotation="90"
            android:src="@drawable/ic_arrow_back"
            app:tint="#CCFFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/aura_home_discover_hint"
            android:textColor="#B3FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
