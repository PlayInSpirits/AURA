<?xml version="1.0" encoding="utf-8"?>
<!-- AURA: "My Wave" hero, the whole first screen of Home. Its glow reaches under the status bar and the
     transparent top bar; its height is set by the code to end where the bottom bars begin. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/aura_wave_block"
    android:layout_width="match_parent"
    android:layout_height="560dp"
    android:clipChildren="false">

    <!-- Animated wave mesh behind the hero -->
    <com.eddyizm.tempus.ui.view.WaveGlowView
        android:id="@+id/aura_wave_glow"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- The hero melts into the sections below -->
    <View
        android:id="@+id/aura_wave_fade"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:layout_gravity="bottom"
        android:background="@drawable/aura_hero_fade" />

    <FrameLayout
        android:id="@+id/aura_wave_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false">

        <FrameLayout
            android:id="@+id/aura_wave_button"
            android:layout_width="101dp"
            android:layout_height="101dp"
            android:layout_gravity="center"
            android:translationY="7dp"
            android:background="@drawable/aura_wave_button"
            android:clickable="true"
            android:contentDescription="@string/aura_wave_play"
            android:focusable="true">

            <ImageView
                android:id="@+id/aura_wave_icon"
                android:layout_width="43dp"
                android:layout_height="43dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/aura_play_rounded"
                app:tint="@android:color/white" />

            <ImageView
                android:id="@+id/aura_wave_cover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/aura_wave_cover_surface"
                android:src="@drawable/ic_albums"
                android:scaleType="centerCrop"
                android:importantForAccessibility="no"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/aura_wave_progress"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:indeterminate="true"
                android:indeterminateTint="#E6FFFFFF"
                android:padding="8dp"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/aura_wave_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:translationY="-85dp"
            android:paddingHorizontal="24dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/aura_wave_display_title"
            android:textAppearance="@style/AuraDisplay"
            android:textSize="30sp" />

        <com.eddyizm.tempus.ui.view.AuraMiniPlayer
            android:id="@+id/aura_home_player"
            android:layout_width="292dp"
            android:layout_height="60dp"
            android:layout_gravity="center"
            android:translationY="115dp" />
    </FrameLayout>

    <!-- "There is more below" -->
    <LinearLayout
        android:id="@+id/aura_wave_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="8dp"
        android:alpha="0.75"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/aura_wave_hint_arrow"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:importantForAccessibility="no"
            android:rotation="90"
            android:src="@drawable/ic_arrow_back"
            app:tint="?attr/colorOnSurfaceVariant" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/aura_home_discover_hint"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
